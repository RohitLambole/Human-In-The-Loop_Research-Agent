# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql+asyncpg://researchos:researchos@localhost:5434/researchos

# Supabase project settings. Never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional: legacy HS256 JWT secret. Leave blank when the project uses asymmetric signing keys/JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
